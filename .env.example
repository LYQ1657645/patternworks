# Copy using: python3 scripts/init_env.py (preserves an existing OpenAI key).
DJANGO_SECRET_KEY=
CONNECTION_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://regex:CHANGE_ME@postgres:5432/regex
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://cache:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RULE_CACHE_TTL_SECONDS=3600
CONNECTION_TTL_SECONDS=3600
SESSION_COOKIE_AGE=86400
