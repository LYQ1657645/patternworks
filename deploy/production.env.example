# Server-only settings; generate fresh secrets: python3 scripts/init_env.py --production
# Edit privately. Never upload real env files or copy values into chat.
APP_ENV_FILE=.env.production
PUBLIC_HOST=
TLS_EMAIL=
DEMO_USER=reviewer
# Wrap the bcrypt hash in single quotes to preserve dollar signs.
DEMO_PASSWORD_HASH=
DJANGO_SECRET_KEY=
CONNECTION_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://regex:CHANGE_ME@postgres:5432/regex
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HEADERS=true
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://redis:6379/2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RULE_CACHE_TTL_SECONDS=3600
CONNECTION_TTL_SECONDS=3600
SESSION_COOKIE_AGE=86400
JOB_STALE_SECONDS=90
